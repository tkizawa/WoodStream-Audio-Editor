<Window x:Class="WoodStreamAudioEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WoodStreamAudioEditor.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Strings.AppTitle}"
        Icon="Resources/app.ico"
        Height="820" Width="1080"
        MinHeight="700" MinWidth="900"
        Background="{DynamicResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content -->
            <RowDefinition Height="*" />
            <!-- Footer Status & Action -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==========================================
             Header Bar
             ========================================== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title & Icon -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Resources/app.png" Width="34" Height="34" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WoodStream Audio Editor" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                        <TextBlock Text="Podcast Master Processor &amp; ID3 Tagger" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Top Right: Language Selector & Save Defaults -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Strings.LanguageLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" SelectedValuePath="Tag" Width="125" Height="28" Margin="0,0,12,0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Auto (System)" Tag="Auto" />
                        <ComboBoxItem Content="日本語" Tag="ja-JP" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                    </ComboBox>
                    <Button Style="{DynamicResource SecondaryButton}" Command="{Binding SaveDefaultsCommand}" ToolTip="{Binding Strings.SaveDefaults}" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " />
                            <TextBlock Text="{Binding Strings.SaveDefaults}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==========================================
             Main Body (2 Columns)
             ========================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Left: Pipeline Settings (File, VST, Audio Params) -->
                <ColumnDefinition Width="1.15*" />
                <!-- Right: Metadata & Log Console -->
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>
                    <!-- 1. File Input / Output Panel -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.SectionInputOutput}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,0,10" />

                            <!-- Input File -->
                            <TextBlock Text="{Binding Strings.InputFile}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding InputFilePath, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                <Button Grid.Column="1" Command="{Binding BrowseInputFileCommand}" Content="{Binding Strings.Browse}" Margin="6,0,0,0" Width="75" />
                            </Grid>

                            <!-- Drop Target Visual Area -->
                            <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,10" Background="{DynamicResource DropAreaBgBrush}">
                                <TextBlock Text="{Binding Strings.DragDropHint}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            </Border>

                            <!-- Output Directory -->
                            <TextBlock Text="{Binding Strings.OutputDirectory}" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputDirectoryPath, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                <Button Grid.Column="1" Command="{Binding BrowseOutputDirectoryCommand}" Content="{Binding Strings.Browse}" Margin="6,0,0,0" Width="75" Style="{DynamicResource SecondaryButton}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. VST Plugin Processing Panel -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Strings.SectionVst}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding AutoDetectPluginsCommand}" Content="{Binding Strings.AutoDetect}" Style="{DynamicResource SecondaryButton}" Padding="8,3" FontSize="11" />
                            </Grid>

                            <TextBlock Text="{Binding Strings.VstNotice}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" />

                            <!-- De-click -->
                            <CheckBox IsChecked="{Binding EnableDeClick}" Content="{Binding Strings.EnableDeClick}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,10" IsEnabled="{Binding EnableDeClick}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DeClickPluginPath, UpdateSourceTrigger=PropertyChanged}" Height="28" ToolTip="{Binding Strings.DeClickLabel}" />
                                <Button Grid.Column="1" Command="{Binding BrowseDeClickPluginCommand}" Content="{Binding Strings.Browse}" Margin="6,0,0,0" Width="75" Style="{DynamicResource SecondaryButton}" />
                            </Grid>

                            <!-- Voice De-noise -->
                            <CheckBox IsChecked="{Binding EnableVoiceDeNoise}" Content="{Binding Strings.EnableVoiceDeNoise}" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,4" IsEnabled="{Binding EnableVoiceDeNoise}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding VoiceDeNoisePluginPath, UpdateSourceTrigger=PropertyChanged}" Height="28" ToolTip="{Binding Strings.VoiceDeNoiseLabel}" />
                                <Button Grid.Column="1" Command="{Binding BrowseVoiceDeNoisePluginCommand}" Content="{Binding Strings.Browse}" Margin="6,0,0,0" Width="75" Style="{DynamicResource SecondaryButton}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. Audio Processing & Silence Truncation Panel -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.SectionAudioProcessing}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,0,10" />

                            <!-- Audio Duration Display (if file selected) -->
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Strings.AudioDuration}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding AudioDurationDisplay, TargetNullValue='--:--'}" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Strings.EstimatedDuration}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding EstimatedDurationDisplay, TargetNullValue='--:--'}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Trim Settings (Start & End Cut) -->
                            <CheckBox IsChecked="{Binding EnableTrim}" Content="{Binding Strings.EnableTrim}" FontWeight="SemiBold" Margin="0,0,0,8" />

                            <StackPanel IsEnabled="{Binding EnableTrim}" Margin="0,0,0,8">
                                <!-- Trim Start Slider -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Strings.TrimStart}" />
                                        <TextBlock Text="{Binding Strings.TrimStartHint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Text="{Binding TrimStartSeconds, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}" Width="52" Height="24" TextAlignment="Right" VerticalContentAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="秒" VerticalAlignment="Center" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="0" Maximum="120" TickFrequency="1" Value="{Binding TrimStartSeconds}" Margin="0,0,0,10" />

                                <!-- Trim End Slider -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Strings.TrimEnd}" />
                                        <TextBlock Text="{Binding Strings.TrimEndHint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Text="{Binding TrimEndSeconds, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}" Width="52" Height="24" TextAlignment="Right" VerticalContentAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="秒" VerticalAlignment="Center" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                                <Slider Minimum="0" Maximum="120" TickFrequency="1" Value="{Binding TrimEndSeconds}" Margin="0,0,0,10" />
                            </StackPanel>

                            <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,4,0,12" />

                            <!-- Car Audio EQ Checkbox -->
                            <StackPanel Margin="0,0,0,12">
                                <CheckBox IsChecked="{Binding EnableCarAudioEq}" Content="{Binding Strings.EnableCarAudioEq}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Strings.CarAudioEqHint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="24,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,12" />

                            <!-- Silence Truncation Checkbox -->
                            <CheckBox IsChecked="{Binding EnableSilenceTruncation}" Content="{Binding Strings.EnableSilenceTruncation}" FontWeight="SemiBold" Margin="0,0,0,10" />

                            <StackPanel IsEnabled="{Binding EnableSilenceTruncation}">
                                <!-- Threshold dB Slider -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Strings.SilenceThreshold}" />
                                        <TextBlock Text="{Binding Strings.SilenceThresholdHint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SilenceThresholdDb, StringFormat='{}{0:F1} dB'}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                </Grid>
                                <Slider Minimum="-70" Maximum="-20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SilenceThresholdDb}" Margin="0,0,0,12" />

                                <!-- Min Silence Duration Slider -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Strings.MinSilenceDuration}" />
                                        <TextBlock Text="{Binding Strings.MinSilenceDurationHint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding MinSilenceDurationMs, StringFormat='{}{0} ms'}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                </Grid>
                                <Slider Minimum="100" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding MinSilenceDurationMs}" Margin="0,0,0,12" />
                            </StackPanel>

                            <!-- MP3 Bitrate -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Strings.Mp3Bitrate}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableBitrates}" SelectedItem="{Binding SelectedBitrate}" Height="28" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="kbps (CBR)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. BGM & Ending Music Mixing Panel -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding Strings.SectionMusicMixing}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,0,10" />

                            <!-- BGM Checkbox & Settings -->
                            <CheckBox IsChecked="{Binding EnableBgm}" Content="{Binding Strings.EnableBgm}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel IsEnabled="{Binding EnableBgm}" Margin="0,0,0,10">
                                <TextBlock Text="{Binding Strings.BgmFile}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding BgmFilePath, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                    <Button Grid.Column="1" Command="{Binding BrowseBgmFileCommand}" Content="{Binding Strings.Browse}" Margin="6,0,0,0" Width="70" Style="{DynamicResource SecondaryButton}" />
                                    <Button Grid.Column="2" Command="{Binding ClearBgmFileCommand}" Content="{Binding Strings.ClearImage}" Margin="4,0,0,0" Width="55" Style="{DynamicResource SecondaryButton}" />
                                </Grid>
                                <TextBlock Text="{Binding Strings.BgmRuleHint}" Foreground="{DynamicResource AccentCyanBrush}" FontSize="11" Margin="0,0,0,6" />

                                <!-- BGM Volume Slider -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Strings.BgmVolume}" />
                                    <TextBlock Grid.Column="1" Text="{Binding BgmVolume, StringFormat='{}{0:P0}'}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                </Grid>
                                <Slider Minimum="0.0" Maximum="1.0" TickFrequency="0.05" Value="{Binding BgmVolume}" Margin="0,0,0,4" />
                            </StackPanel>

                            <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,4,0,10" />

                            <!-- Ending Music Checkbox & Settings -->
                            <CheckBox IsChecked="{Binding EnableEnding}" Content="{Binding Strings.EnableEnding}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel IsEnabled="{Binding EnableEnding}">
                                <TextBlock Text="{Binding Strings.EndingFile}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding EndingFilePath, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                                    <Button Grid.Column="1" Command="{Binding BrowseEndingFileCommand}" Content="{Binding Strings.Browse}" Margin="6,0,0,0" Width="70" Style="{DynamicResource SecondaryButton}" />
                                    <Button Grid.Column="2" Command="{Binding ClearEndingFileCommand}" Content="{Binding Strings.ClearImage}" Margin="4,0,0,0" Width="55" Style="{DynamicResource SecondaryButton}" />
                                </Grid>
                                <TextBlock Text="{Binding Strings.EndingRuleHint}" Foreground="{DynamicResource AccentCyanBrush}" FontSize="11" Margin="0,0,0,6" />

                                <!-- Ending Volume Slider -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Strings.EndingVolume}" />
                                    <TextBlock Grid.Column="1" Text="{Binding EndingVolume, StringFormat='{}{0:P0}'}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                </Grid>
                                <Slider Minimum="0.0" Maximum="1.0" TickFrequency="0.05" Value="{Binding EndingVolume}" Margin="0,0,0,4" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <!-- Metadata Panel -->
                    <RowDefinition Height="Auto" />
                    <!-- Log Console Panel -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 4. Metadata / ID3 Panel -->
                <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding Strings.SectionMetadata}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Strings.TagTitle}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding TagTitle, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Strings.TagArtist}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding TagArtist, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Strings.TagAlbum}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding TagAlbum, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Strings.TagTrack}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding TagTrackNumber, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                        </Grid>

                        <!-- Artwork Image Selection & Preview -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Strings.TagArtwork}" VerticalAlignment="Center" />
                            
                            <!-- Thumbnail & Path -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="42" Height="42" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                                    <Image Source="{Binding TagArtworkPath}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding TagArtworkPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>

                            <!-- Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding BrowseArtworkCommand}" Content="{Binding Strings.SelectImage}" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Padding="8,4" />
                                <Button Command="{Binding ClearArtworkCommand}" Content="{Binding Strings.ClearImage}" Style="{DynamicResource SecondaryButton}" Padding="8,4" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 5. Action Log Console -->
                <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Strings.SectionActionLog}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding ClearLogCommand}" Content="{Binding Strings.ClearLog}" Style="{DynamicResource SecondaryButton}" FontSize="11" Padding="8,2" />
                        </Grid>

                        <!-- Log Console TextBox -->
                        <TextBox x:Name="LogTextBox" Grid.Row="1" Text="{Binding LogOutput, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource ConsoleBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                                 FontFamily="Consolas, Meiryo UI" FontSize="11"
                                 TextChanged="LogTextBox_TextChanged" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==========================================
             Footer: Progress Bar & Execution Actions
             ========================================== -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Status & Progress -->
                    <ColumnDefinition Width="*" />
                    <!-- Action Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Progress Section -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat='{}{0:F0}%'}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                    </Grid>
                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" />
                </StackPanel>

                <!-- Start / Cancel Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource WoodAccentButton}"
                            Command="{Binding StartProcessingCommand}"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                            Padding="24,10" FontSize="14" FontWeight="Bold" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶ " FontSize="14" />
                            <TextBlock Text="{Binding Strings.StartProcessing}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{DynamicResource SecondaryButton}"
                            Command="{Binding CancelProcessingCommand}"
                            IsEnabled="{Binding IsProcessing}"
                            Content="{Binding Strings.Cancel}"
                            Padding="16,10" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
